GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/var/secrets/google/adc.json
GOOGLE_CREDENTIALS_HOST_PATH=/absolute/path/to/application_default_credentials.json
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
QDRANT_URL=http://qdrant:6333
CENSUS_API_BASE_URL=http://backend:8000
CENSUS_UI_CONNECT_TIMEOUT_SECONDS=5
CENSUS_UI_READ_TIMEOUT_SECONDS=180
CENSUS_UI_MAX_ARTIFACT_BYTES=10485760
ARTIFACT_EXECUTION_TIMEOUT_SECONDS=30
ARTIFACT_MAX_FILES=8
ARTIFACT_MAX_TOTAL_BYTES=20971520
DOCUMENT_UPLOAD_ENABLED=true
DOCUMENT_UPLOAD_MAX_BYTES=52428800
DOCUMENT_UPLOAD_MAX_PAGES=400
QDRANT_COLLECTION=census_documents
DATA_ROOT=data
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
INGESTION_VERSION=1
WORKSPACE_ROOT=workspace
SKILLS_DIR=skills
AGENT_MAX_STEPS=24
AGENT_MAX_TOOL_CALLS=12
AGENT_MEMORY_TURN_THRESHOLD=12
AGENT_PROVIDER_TIMEOUT_SECONDS=120
AGENT_REQUEST_TIMEOUT_SECONDS=240
AGENT_PROVIDER_MAX_RETRIES=2
AGENT_ASSESSMENT_MAX_CHARACTERS=12000
AGENT_ASSESSMENT_MAX_CHUNKS=12
LANGGRAPH_STRICT_MSGPACK=true

# --- Optional: scaled deployment (docker-compose.scale.yml) ---
# Postgres state for API replicas and the durable upload worker. Required only with that overlay.
POSTGRES_PASSWORD=change-me
INGESTION_MAX_RETRIES=3
INGESTION_VISIBILITY_TIMEOUT_SECONDS=1800

# --- Optional: Langfuse tracing (off unless all three are set) ---
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Prompts, evidence, and answers stay local unless this is true.
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_ENVIRONMENT=local
